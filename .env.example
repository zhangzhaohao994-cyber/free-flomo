# Node 24.16+; npm start uses .env with --env-file-if-exists=.env
HOST=127.0.0.1
PORT=4188
# Register your first account locally before exposing the service.
ALLOW_REGISTRATION=false
ALLOWED_ORIGINS=http://127.0.0.1:4187,http://localhost:4187,http://127.0.0.1:4188,http://localhost:4188,https://zhangzhaohao994-cyber.github.io
# Optional AI Gateway settings. No model or key is bundled.
AI_GATEWAY_API_KEY=
AI_MODEL=
EMBEDDING_MODEL=
# Optional OpenAI-compatible speech transcription endpoint.
SPEECH_API_URL=
SPEECH_API_KEY=
SPEECH_MODEL=
# Use your own dedicated WeChat service account callback; never overwrite an existing account integration blindly.
WECHAT_TOKEN=
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_AES_KEY=
